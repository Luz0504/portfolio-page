---
interface Props {
  href?: string;
  label?: string;
}

const { href = "/", label = "Go back" } = Astro.props;
---

<a
  href={href}
  data-back-button
  class="group inline-flex items-center gap-2 text-2xl font-semibold text-[#78302f] my-5"
>
  <span class="transition-transform duration-200 group-hover:-translate-x-1">
    ←
  </span>

  <span
    class="underline underline-offset-4 decoration-[#f58d7b] decoration-2 transition-colors duration-200 group-hover:text-[#d18b42]"
  >
    {label}
  </span>
</a>

<script>
  document.querySelectorAll("[data-back-button]").forEach((button) => {
    button.addEventListener("click", (event) => {
      if (window.history.length > 1) {
        event.preventDefault();
        window.history.back();
      }
    });
  });
</script>
