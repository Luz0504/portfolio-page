---
import { supabase } from "../lib/supabase";

interface Props {
  images: {
    title: string;
    index: number;
  }[];
}

const images = Astro.props.images ?? [];
const titles = [...new Set(images.map((image) => image.title))];

const { data: projects, error } = await supabase
  .from("projects")
  .select("title, images")
  .in("title", titles);

if (error) {
  console.error("Error al cargar proyectos:", error.message);
}

const selectedImages = images
  .map((selection) => {
    const project = projects?.find((p) => p.title === selection.title);

    const src = Array.isArray(project?.images)
      ? project.images[selection.index]
      : null;

    const isVideo =
      typeof src === "string" && /\.(mp4|webm|ogg|mov)(\?.*)?$/i.test(src);

    return {
      title: selection.title,
      index: selection.index,
      src,
      isVideo,
    };
  })
  .filter((item) => item.src);

const carouselId = `carousel-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="w-full h-full min-h-0 flex flex-col" data-carousel id={carouselId}>
  <div class="flex flex-1 min-h-0 items-stretch gap-1">
    <button
      type="button"
      data-prev
      aria-label="Ver imágenes anteriores"
      class="shrink-0 px-1 text-lg hover:text-[#87312e] transition-colors disabled:opacity-20 disabled:cursor-not-allowed"
    >
      ‹
    </button>

    <div
      data-track
      class="flex flex-1 gap-1.5 overflow-x-auto snap-x snap-mandatory scroll-smooth rounded-xl"
      style="scrollbar-width: none;"
    >
      {
        selectedImages.map((item) => (
          <div class="w-[calc((100%-0.75rem)/3)] min-w-[calc((100%-0.75rem)/3)] snap-start overflow-hidden">
            {item.isVideo ? (
              <video
                src={item.src}
                controls
                playsinline
                preload="metadata"
                class="h-full w-full object-cover"
                aria-label={`${item.title} - video ${item.index + 1}`}
              />
            ) : (
              <img
                src={item.src}
                alt={`${item.title} - imagen ${item.index + 1}`}
                class="h-full w-full object-cover"
                loading="lazy"
              />
            )}
          </div>
        ))
      }
    </div>

    <button
      type="button"
      data-next
      aria-label="Ver imágenes siguientes"
      class="shrink-0 px-1 text-lg hover:text-[#87312e] transition-colors disabled:opacity-20 disabled:cursor-not-allowed"
    >
      ›
    </button>
  </div>
</div>

<script>
  document.querySelectorAll("[data-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-track]");
    const prev = carousel.querySelector<HTMLButtonElement>("[data-prev]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-next]");

    if (!track || !prev || !next) return;

    const updateButtons = () => {
      const maxScroll = track.scrollWidth - track.clientWidth;

      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= maxScroll - 2;
    };

    const scrollCarousel = (direction: number) => {
      const firstSlide = track.firstElementChild;
      if (!firstSlide) return;

      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      const distance = firstSlide.getBoundingClientRect().width + gap;

      track.scrollBy({
        left: distance * 3 * direction,
        behavior: "smooth",
      });
    };

    prev.addEventListener("click", () => scrollCarousel(-1));
    next.addEventListener("click", () => scrollCarousel(1));

    track.addEventListener("scroll", updateButtons);
    window.addEventListener("resize", updateButtons);

    updateButtons();
  });
</script>
