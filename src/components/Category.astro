---
import ImageCircle from "../layouts/ImageCircle.astro";

interface Props {
  imageSrc: any;
  overlaySrc?: any;
  category: string;
  description: string;
  side?: "left" | "right";
}

const {
  imageSrc,
  overlaySrc,
  category,
  description,
  side = "left",
} = Astro.props;

const textOnLeft = side === "right";
---

<section
  class:list={[
    "gap-10 flex items-center rounded-[10rem] p-10",
    textOnLeft ? "flex-row-reverse" : "flex-row",
  ]}
>
  <ImageCircle imageSrc={imageSrc} overlaySrc={overlaySrc} text={category} />

  <div
    class:list={["flex-1", textOnLeft ? "text-right" : "text-left"]}
    class="bg-white border-5 border-orange-200 p-15 rounded-2xl shadow-lg"
  >
    <h2 class="text-4xl">
      {category}
    </h2>

    <p class="text-lg md:text-2xl">
      {description}
    </p>
  </div>
</section>
