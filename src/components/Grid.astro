---
import { supabase } from "../lib/supabase";

interface Props {
  titles: string[];
}

const { titles } = Astro.props;

const { data: projects, error } = await supabase
  .from("projects")
  .select("title, type, subtype, description, images")
  .in("title", titles);

if (error) {
  console.error("Error al cargar proyectos:", error.message);
}

const selectedProjects = titles
  .map((title) => projects?.find((p) => p.title === title))
  .filter((project) => project != null);
---

<div class="grid grid-cols-2">
  {selectedProjects.map((project) => {
    const image = Array.isArray(project.images)
      ? project.images[0]
      : null;

    return image ? (
      <img
        src={image}
        alt={project.title ?? "Imagen del proyecto"}
        class="w-300 h-50 img-fit object-cover"
        loading="lazy"
      />
    ) : null;
  })}
</div>
