---
import { supabase } from "../lib/supabase";

interface Props {
  images: {
    title: string;
    index: number;
  }[];
}

const images = Astro.props.images ?? [];

const titles = [...new Set(images.map((image) => image.title))];

const { data: projects, error } = await supabase
  .from("projects")
  .select("title, images")
  .in("title", titles);

if (error) {
  console.error("Error al cargar proyectos:", error.message);
}

const selectedImages = images.slice(0, 4).map((selection) => {
  const project = projects?.find(
    (p) => p.title === selection.title
  );

  const image = Array.isArray(project?.images)
    ? project.images[selection.index]
    : null;

  return {
    title: selection.title,
    index: selection.index,
    src: image,
  };
});
---

<div class="grid grid-cols-2 gap-2">
  {selectedImages.map((image) =>
    image.src ? (
      <img
        src={image.src}
        alt={`${image.title} - imagen ${image.index + 1}`}
        class="w-full h-50 object-cover"
        loading="lazy"
      />
    ) : null
  )}
</div>
