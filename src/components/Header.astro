---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
---

<header class="sticky top-0 z-50 w-full bg-white px-4 py-4 sm:px-6 md:py-5">
  <nav class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4">
    <h2 class="min-w-0 text-xl font-medium sm:text-2xl">
      <a href="/" class="whitespace-nowrap">
        {SITE_TITLE}
      </a>
    </h2>

    <div class="flex shrink-0 items-center gap-4 sm:gap-8">
      <p>
        <HeaderLink href="/">Home</HeaderLink>
      </p>
      <p>
        <HeaderLink href="/about">About</HeaderLink>
      </p>
    </div>
  </nav>
</header>