---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
---

<header class="bg-white w-full px-2 py-6 sticky top-0 z-15">
  <nav class="mx-auto flex max-w-6xl items-center justify-between">
    <h2 class="text-2xl">
      <a href="/">{SITE_TITLE}</a>
    </h2>
    <div class="flex gap-8">
      <p><HeaderLink href="/">Home</HeaderLink></p>
      <p><HeaderLink href="/about">About</HeaderLink></p>
    </div>
  </nav>
</header>
