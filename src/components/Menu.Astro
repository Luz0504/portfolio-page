---
import type { ImageMetadata } from "astro";

interface Props {
  pattern: ImageMetadata;
  title?: string;
}

const { pattern, title = "Today's Menu" } = Astro.props;
---

<section
  class="my-20 mx-20 max-w-7xl bg-repeat p-7 md:p-6 shadow-black shadow-2xl"
  style={`background-image: url('${pattern.src}');`}
>
  <div class="border-6 border-[#f58d7b] bg-white p-5 md:p-8 lg:p-10">
    <h2
      class="mb-10 text-4xl uppercase text-[#78302f] md:mb-14 md:text-6xl"
    >
      {title}
    </h2>

    <div class="space-y-10 md:space-y-12">
      <slot />
    </div>
  </div>
</section>