---
import type { ImageMetadata } from "astro";

interface Props {
  pattern: ImageMetadata;
  title?: string;
  programs?: ImageMetadata[];
}

const { pattern, title = "Today's Menu", programs = [] } = Astro.props;

import BackButton from "./BackButton.astro";
---

<section
  class="mx-auto my-20 w-[calc(100%-2rem)] max-w-7xl bg-repeat p-7 shadow-black shadow-2xl rounded-4xl md:w-[calc(100%-4rem)] md:p-6"
  style={`background-image: url('${pattern.src}');`}
>
  <div class="border-6 border-[#f58d7b] bg-white p-5 md:p-8 lg:p-10">
    <BackButton href="/design" label="Back" />

    <div class="mb-10 flex flex-wrap items-end justify-between gap-4 md:mb-14">
      <h2 class="text-4xl uppercase text-[#78302f] md:text-6xl">
        {title}
      </h2>

      {
        programs.length > 0 && (
          <div class="flex items-center gap-3 pb-1 h-full">
            {programs.map((program) => (
              <img
                src={program.src}
                alt=""
                class=" w-7 object-contain md:h-full md:w-9 hover:scale-110 transition-transform duration-100"
                loading="lazy"
              />
            ))}
          </div>
        )
      }
    </div>

    <div class="space-y-10 md:space-y-12">
      <slot />
    </div>
  </div>
</section>
