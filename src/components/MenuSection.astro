---
interface Props {
  title: string;
  side?: "left" | "right";
}

const { title, side = "left" } = Astro.props;
---

<section
  class="mt-10 grid w-full grid-cols-1 items-start gap-6 sm:mt-12 sm:gap-8 lg:mt-15 lg:grid-cols-2 lg:gap-10"
>
  <div class:list={["min-w-0 w-full", side === "right" && "lg:order-2"]}>
    <h3 class="mb-3 break-words text-2xl uppercase sm:text-3xl">
      {title}
    </h3>

    <div class="min-w-0 w-full">
      <slot />
    </div>
  </div>

  <div class:list={["min-w-0 w-full", side === "right" && "lg:order-1"]}>
    <slot name="images" />
  </div>
</section>
