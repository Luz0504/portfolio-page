---
import type { ImageMetadata } from "astro";
import imageDefault from "../assets/images/denacimiento.jpg";
import overlayDefault from "../assets/images/mug.png";

interface Props {
  imageSrc?: ImageMetadata;
  altText?: string;
  overlaySrc?: ImageMetadata;
  text?: string;
}

const {
  imageSrc = imageDefault,
  altText = "Aaaaaaaa",
  overlaySrc = overlayDefault,
  text = "Diseño gráfico",
} = Astro.props;
---

<div class="relative aspect-square rounded-full w-64 hover:scale-105 hover:shadow-lg transition-transform duration-300 ease-in-out cursor-pointer">

  <img
    src={overlaySrc.src}
    alt=""
    class="pointer-events-none absolute inset-0 z-0 h-full w-full object-contain rounded-full"
  />

  <div class="absolute inset-[15%] z-10 overflow-hidden rounded-full">
    <img src={imageSrc.src} alt={altText} class="h-full w-full object-cover" />
  </div>

</div>
