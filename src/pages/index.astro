---
import Layout from "../layouts/Layout.astro";
import Category from "../components/Category.astro";

import {
  soles,
  denacimiento,
  fruit,
  pattern,
  polka,
  toast,
  pancakes,
} from "../assets/images/index.js";
---

<body class="bg-teal-200" style={`background-image: url('${polka.src}');`}>
  <Layout>
    <section
      class="sticky top-0 z-0 flex flex-col items-center justify-center py-20"
    >
      <div class="bg-teal-200 items-center text-center p-10">
        <h1 class="text-7xl p-5">Welcome to my portfolio!</h1>
        <h3 class="text-4xl">What would you like to order?</h3>
      </div>
    </section>

    <section
      class="relative z-10 w-full bg-repeat p-6 pt-20 md:p-20"
      style={`background-image: url('${pattern.src}');`}
    >
      <Category
        imageSrc={soles}
        category="Editorial Design"
        description="A good coffee is what you need to read a good book! I have a variety of editorial designs for magazine layouts."
        side="left"
      />

      <Category
        imageSrc={denacimiento}
        overlaySrc={fruit}
        category="Character design / Illustration"
        description="Colors and shapes! From original characters to commissioned art, just like a fruit salad, I have a variety of designs for you to check out!"
        side="right"
      />

      <Category
        imageSrc={undefined}
        overlaySrc={pancakes}
        category="Graphic design"
        description="Designing is like making a tower of pancakes! Pictures get added on top of each other, following a certain structure."
        side="left"
      />

      <Category
        imageSrc={undefined}
        overlaySrc={toast}
        category="UX/UI"
        description="User Experience and User Interface are like jam to a plain toast! Designed with Figma, I have different websites and apps you can look at!"
        side="right"
      />
    </section>
  </Layout>
</body>
