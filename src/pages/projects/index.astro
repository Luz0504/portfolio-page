---
import Layout from "../../layouts/Layout.astro";
import Menu from "../../components/Menu.astro";
import MenuSection from "../../components/MenuSection.astro";

import pattern from "../../assets/images/pattern.png";
import { denacimiento } from "../../assets/images/index.js";
---

<Layout>
  <Menu pattern={pattern} title="My Projects">
    <MenuSection title="Graphic Design">
      <p>Proyectos de diseño gráfico, identidad visual y diseño editorial.</p>

      <div slot="images" class="grid grid-cols-2 gap-4">
        <img src={denacimiento.src} alt="Proyecto 1" class="w-full h-auto" />
        <img src={denacimiento.src} alt="Proyecto 2" class="w-full h-auto" />
        <img src={denacimiento.src} alt="Proyecto 3" class="w-full h-auto" />
        <img src={denacimiento.src} alt="Proyecto 4" class="w-full h-auto" />
      </div>
    </MenuSection>

    <MenuSection title="Illustration" side="right">
      <p>Una selección de mis proyectos de ilustración.</p>

      <div slot="images" class="grid grid-cols-2 gap-4">
        <img src={denacimiento.src} alt="Proyecto 1" class="w-full h-auto" />
        <img src={denacimiento.src} alt="Proyecto 2" class="w-full h-auto" />
        <img src={denacimiento.src} alt="Proyecto 3" class="w-full h-auto" />
        <img src={denacimiento.src} alt="Proyecto 4" class="w-full h-auto" />
      </div>
    </MenuSection>

    <MenuSection title="Audiovisual">
      <p>Proyectos de edición y producción audiovisual.</p>

      <div slot="images" class="grid grid-cols-2 gap-4">
        <img src={denacimiento.src} alt="Proyecto 1" class="w-full h-auto" />
        <img src={denacimiento.src} alt="Proyecto 2" class="w-full h-auto" />
        <img src={denacimiento.src} alt="Proyecto 3" class="w-full h-auto" />
        <img src={denacimiento.src} alt="Proyecto 4" class="w-full h-auto" />
      </div>
    </MenuSection>

    <MenuSection title="Audiovisual" side="right">
      <p>Proyectos de edición y producción audiovisual.</p>

      <div slot="images" class="grid grid-cols-2 gap-4">
        <img src={denacimiento.src} alt="Proyecto 1" class="w-full h-auto" />
        <img src={denacimiento.src} alt="Proyecto 2" class="w-full h-auto" />
        <img src={denacimiento.src} alt="Proyecto 3" class="w-full h-auto" />
        <img src={denacimiento.src} alt="Proyecto 4" class="w-full h-auto" />
      </div>
    </MenuSection>
  </Menu>
</Layout>
