---
import Layout from "../../layouts/Layout.astro";
import Menu from "../../components/Menu.astro";
import Illustration from "../../content/work/Illustration.mdx";
import Design from "../../content/work/Design.mdx";
import Ux from "../../content/work/Ux.mdx";
import Video from "../../content/work/Video.mdx";

import {
  pattern,
  figma,
  firealpaca,
  photoshop,
  after,
  premiere,
  illustrator,
} from "../../assets/images/index.js";
---

<Layout>
  <Menu
    pattern={pattern}
    title="Today's Menu"
    programs={[firealpaca, figma, after, premiere, photoshop, illustrator]}
  >
    <Illustration />
    <Design />
    <Video />
    <Ux />
  </Menu>
</Layout>
